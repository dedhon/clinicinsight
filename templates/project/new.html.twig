{% extends 'base.html.twig' %}

{% block title %}Nuevo proyecto - ClinicInsight{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="ci-hero p-4 p-lg-5 mb-4">
            <div class="ci-eyebrow mb-2">Nuevo workspace</div>
            <h1 class="ci-page-title mb-2">Crea un proyecto de analisis.</h1>
            <p class="ci-muted mb-0">Agrupa datasets, dashboards y exportaciones bajo un mismo objetivo de negocio.</p>
        </div>

        <form method="post" class="ci-panel p-4">
            <div class="row g-4">
                <div class="col-md-7">
                    <label class="form-label fw-semibold" for="name">Nombre del proyecto</label>
                    <input class="form-control form-control-lg" id="name" name="name" placeholder="Ej. Rendimiento Q2, Facturacion mutuas..." required>
                </div>
                <div class="col-md-5">
                    <div class="ci-quick-action h-100">
                        <div class="ci-kpi-label">Siguiente paso</div>
                        <div class="fw-semibold mt-2">Subir dataset</div>
                        <div class="small text-muted">Al crearlo podras cargar Excel, CSV o JSON.</div>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold" for="description">Descripcion</label>
                    <textarea class="form-control" id="description" name="description" rows="4" placeholder="Objetivo del analisis, periodo, area o equipo implicado."></textarea>
                </div>
                <div class="col-12 d-flex justify-content-between align-items-center">
                    <a class="btn btn-outline-secondary" href="{{ path('dashboard') }}">Cancelar</a>
                    <button class="btn btn-primary btn-lg">Crear proyecto</button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}
