{% extends 'base.html.twig' %}

{% block title %}{{ 'project_new.title'|trans }} - ClinicInsight{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="ci-hero p-4 p-lg-5 mb-4">
            <div class="ci-eyebrow mb-2">{{ app.user.customer.name }}</div>
            <h1 class="ci-page-title mb-2">{{ 'project_new.heading'|trans }}</h1>
            <p class="ci-muted mb-0">{{ 'project_new.subtitle'|trans }}</p>
        </div>

        <form method="post" class="ci-panel p-4">
            <div class="row g-4">
                <div class="col-md-7">
                    <label class="form-label fw-semibold" for="name">{{ 'project_new.name'|trans }}</label>
                    <input class="form-control form-control-lg" id="name" name="name" placeholder="{{ 'project_new.placeholder'|trans }}" required>
                </div>
                <div class="col-md-5">
                    <div class="ci-quick-action h-100">
                        <div class="ci-kpi-label">{{ 'project_new.next_step'|trans }}</div>
                        <div class="fw-semibold mt-2">{{ 'project_new.upload'|trans }}</div>
                        <div class="small text-muted">{{ 'project_new.upload_help'|trans }}</div>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold" for="description">{{ 'project_new.description'|trans }}</label>
                    <textarea class="form-control" id="description" name="description" rows="4" placeholder="{{ 'project_new.description_placeholder'|trans }}"></textarea>
                </div>
                <div class="col-12 d-flex justify-content-between align-items-center">
                    <a class="btn btn-outline-secondary" href="{{ path('dashboard') }}">{{ 'project_new.cancel'|trans }}</a>
                    <button class="btn btn-primary btn-lg">{{ 'project_new.create'|trans }}</button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}
