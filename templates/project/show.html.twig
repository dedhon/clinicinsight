{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} - ClinicInsight{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">{{ project.name }}</h1>
        <p class="text-muted">{{ project.description }}</p>
    </div>
    <a class="btn btn-outline-secondary" href="{{ path('dashboard') }}">Volver</a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">Subir dataset</h2>
                <form method="post" enctype="multipart/form-data" action="{{ path('project_upload', {id: project.id}) }}">
                    <div class="mb-3">
                        <input class="form-control" type="file" name="dataset" accept=".xlsx,.xls,.csv,.json" required>
                    </div>
                    <button class="btn btn-primary">Subir y analizar columnas</button>
                </form>
                <form method="post" action="{{ path('project_demo', {id: project.id}) }}" class="mt-3">
                    <button class="btn btn-outline-primary">Crear dataset demo</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <h2 class="h5">Archivos</h2>
        <div class="list-group">
            {% for file in project.uploadedFiles %}
                <a class="list-group-item list-group-item-action d-flex justify-content-between" href="{{ path(file.status == 'parsed' ? 'upload_mapping' : 'report_show', {id: file.id}) }}">
                    <span>{{ file.originalName }}</span>
                    <span class="badge text-bg-secondary">{{ file.status }}</span>
                </a>
            {% else %}
                <div class="list-group-item text-muted">Sin archivos todavia.</div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
