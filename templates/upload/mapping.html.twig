{% extends 'base.html.twig' %}

{% block title %}{{ 'mapping.title'|trans }} - ClinicInsight{% endblock %}

{% block body %}
<div class="ci-actionbar py-3 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="ci-eyebrow mb-1">{{ 'mapping.title'|trans }}</div>
            <h1 class="h3 mb-1">{{ 'mapping.heading'|trans }}</h1>
            <div class="text-muted">{{ uploadedFile.originalName }} · {{ uploadedFile.rowCount }} filas</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('project_show', {id: uploadedFile.project.id}) }}">{{ 'project.project'|trans }}</a>
            <button class="btn btn-primary" form="mappingForm">{{ 'mapping.normalize'|trans }}</button>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="ci-panel p-3 h-100">
            <div class="ci-kpi-label">{{ 'mapping.compatibility'|trans }}</div>
            <div class="d-flex align-items-end gap-2">
                <div class="ci-kpi-value">{{ profile.score }}%</div>
                <div class="pb-2 text-muted">{{ profile.level }}</div>
            </div>
            <div class="progress mt-2" role="progressbar" aria-valuenow="{{ profile.score }}" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar {{ profile.score >= 75 ? 'bg-success' : (profile.score >= 45 ? 'bg-warning' : 'bg-danger') }}" style="width: {{ profile.score }}%"></div>
            </div>
            <div class="small text-muted mt-3">{{ profile.type }}</div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ci-panel p-3 h-100">
            <div class="ci-kpi-label">{{ 'mapping.columns'|trans }}</div>
            <div class="d-flex gap-3 mt-2">
                <div><div class="h4 mb-0">{{ profile.mapped_count }}</div><div class="small text-muted">{{ 'mapping.mapped'|trans }}</div></div>
                <div><div class="h4 mb-0">{{ profile.ignored_count }}</div><div class="small text-muted">{{ 'mapping.ignored'|trans }}</div></div>
                <div><div class="h4 mb-0">{{ profile.total_columns }}</div><div class="small text-muted">{{ 'mapping.total'|trans }}</div></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ci-panel p-3 h-100">
            <div class="ci-kpi-label">{{ 'mapping.warnings'|trans }}</div>
            {% if profile.warnings %}
                <ul class="small mb-0 mt-2 ps-3">
                    {% for warning in profile.warnings %}
                        <li>{{ warning }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="small text-muted mb-0 mt-2">{{ 'mapping.no_warnings'|trans }}</p>
            {% endif %}
        </div>
    </div>
</div>

<div class="ci-panel p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">{{ 'mapping.preview'|trans }}</h2>
        <span class="badge text-bg-light border">{{ 'mapping.first_rows'|trans({'{count}': profile.preview_rows|length}) }}</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
            <tr>
                {% for column in uploadedFile.columns %}
                    <th>{{ column.originalName }}</th>
                {% endfor %}
            </tr>
            </thead>
            <tbody>
            {% for row in profile.preview_rows %}
                <tr>
                    {% for column in uploadedFile.columns %}
                        <td class="small text-nowrap">{{ row[column.originalName]|default('') }}</td>
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<form method="post" id="mappingForm">
    <div class="table-responsive ci-panel">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>{{ 'mapping.original_column'|trans }}</th>
                <th>{{ 'mapping.examples'|trans }}</th>
                <th>{{ 'mapping.dashboard_meaning'|trans }}</th>
                <th>{{ 'mapping.privacy'|trans }}</th>
                <th>{{ 'mapping.reason'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for column in uploadedFile.columns %}
                <tr data-mapping-row data-suggestion="{{ fieldSuggestions[column.id]|default('') }}">
                    <td>
                        <div class="fw-semibold">{{ column.originalName }}</div>
                        <div class="small text-muted">{{ column.detectedType ?: 'mapping.not_detected'|trans }}</div>
                    </td>
                    <td class="small text-muted">{{ column.exampleValues|default([])|join(', ') }}</td>
                    <td>
                        <select class="form-select" name="mapped_field[{{ column.id }}]" data-mapping-select {{ column.ignored ? 'disabled' }}>
                            <option value="">{{ 'mapping.unmapped'|trans }}</option>
                            {% for field in allowedFields %}
                                <option value="{{ field }}" {{ column.mappedField == field ? 'selected' }}>{{ fieldLabels[field]|default(field) }}</option>
                            {% endfor %}
                        </select>
                        <div class="small text-muted mt-1" data-mapping-help>
                            {% if column.ignored %}
                                {{ 'mapping.excluded_privacy'|trans }}
                            {% elseif column.mappedField %}
                                {{ 'mapping.internal_field'|trans({'{field}': column.mappedField}) }}
                            {% else %}
                                {{ 'mapping.choose_help'|trans }}
                            {% endif %}
                        </div>
                    </td>
                    <td>
                        <label class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="ignored[{{ column.id }}]" value="1" data-ignore-toggle {{ column.ignored ? 'checked' }}>
                            <span class="form-check-label small">{{ 'mapping.do_not_use'|trans }}</span>
                        </label>
                    </td>
                    <td class="small">
                        {% if column.ignored %}
                            <span class="badge text-bg-warning">{{ 'mapping.sensitive'|trans }}</span>
                        {% elseif column.mappedField %}
                            <span class="badge text-bg-success">{{ (column.confidence * 100)|round }}%</span>
                        {% endif %}
                        <div class="text-muted mt-1">{{ column.reason }}</div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-primary btn-lg">{{ 'mapping.generate'|trans }}</button>
    </div>
</form>

<script>
const fieldLabels = {{ fieldLabels|json_encode|raw }};
const mappingText = {
    excluded: '{{ 'mapping.excluded_privacy'|trans }}',
    choose: '{{ 'mapping.choose_help'|trans }}',
};

document.querySelectorAll('[data-mapping-row]').forEach(row => {
    const checkbox = row.querySelector('[data-ignore-toggle]');
    const select = row.querySelector('[data-mapping-select]');
    const help = row.querySelector('[data-mapping-help]');
    const suggestion = row.dataset.suggestion || '';

    const updateState = () => {
        if (checkbox.checked) {
            select.disabled = true;
            help.textContent = mappingText.excluded;
            return;
        }

        select.disabled = false;
        if (!select.value && suggestion) {
            select.value = suggestion;
        }

        help.textContent = select.value
            ? `Usaremos esta columna como: ${fieldLabels[select.value] || select.value}.`
            : mappingText.choose;
    };

    checkbox.addEventListener('change', updateState);
    select.addEventListener('change', updateState);
    updateState();
});
</script>
{% endblock %}
