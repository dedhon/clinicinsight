{% extends 'base.html.twig' %}

{% block title %}Mapeo - ClinicInsight{% endblock %}

{% block body %}
<h1 class="h3 mb-1">Confirmar mapeo</h1>
<p class="text-muted">Archivo: {{ uploadedFile.originalName }}. Revisa columnas sensibles antes de normalizar.</p>

<form method="post">
    <div class="table-responsive bg-white border rounded">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>Columna original</th>
                <th>Ejemplos</th>
                <th>Campo normalizado</th>
                <th>Ignorar</th>
                <th>Motivo</th>
            </tr>
            </thead>
            <tbody>
            {% for column in uploadedFile.columns %}
                <tr>
                    <td class="fw-semibold">{{ column.originalName }}</td>
                    <td class="small text-muted">{{ column.exampleValues|default([])|join(', ') }}</td>
                    <td>
                        <select class="form-select" name="mapped_field[{{ column.id }}]">
                            <option value="">Sin mapear</option>
                            {% for field in allowedFields %}
                                <option value="{{ field }}" {{ column.mappedField == field ? 'selected' }}>{{ field }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="ignored[{{ column.id }}]" value="1" {{ column.ignored ? 'checked' }}>
                    </td>
                    <td class="small text-muted">{{ column.reason }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <button class="btn btn-primary mt-3">Normalizar y generar dashboard</button>
</form>
{% endblock %}

