<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}ClinicInsight{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <style>
        :root {
            --ci-ink: #17212b;
            --ci-muted: #657383;
            --ci-line: #dce3ea;
            --ci-panel: #ffffff;
            --ci-teal: #0f766e;
            --ci-coral: #c2410c;
            --ci-amber: #b45309;
            --ci-violet: #6d5bd0;
        }

        body {
            color: var(--ci-ink);
            background:
                linear-gradient(180deg, #f7fafc 0, #edf3f7 360px, #f6f8fb 100%);
            font-size: 15px;
        }

        .navbar {
            backdrop-filter: blur(12px);
        }

        .ci-shell {
            max-width: 1320px;
        }

        .ci-panel {
            background: var(--ci-panel);
            border: 1px solid var(--ci-line);
            border-radius: 8px;
            box-shadow: 0 10px 28px rgba(23, 33, 43, .06);
        }

        .ci-kpi {
            min-height: 138px;
            border-left: 4px solid var(--accent, var(--ci-teal));
        }

        .ci-kpi-label {
            color: var(--ci-muted);
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .ci-kpi-value {
            font-size: clamp(1.55rem, 2vw, 2.25rem);
            font-weight: 800;
            letter-spacing: 0;
        }

        .ci-kpi-sub {
            color: var(--ci-muted);
            font-size: .875rem;
        }

        .ci-chart {
            min-height: 365px;
        }

        .ci-panel {
            transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        }

        .ci-panel:hover {
            transform: translateY(-2px);
            border-color: #b8c7d5;
            box-shadow: 0 16px 36px rgba(23, 33, 43, .10);
        }

        .ci-kpi-value {
            transition: color .2s ease;
        }

        .ci-segment {
            display: inline-flex;
            gap: 4px;
            padding: 4px;
            background: #eef4f7;
            border: 1px solid var(--ci-line);
            border-radius: 8px;
        }

        .ci-segment button {
            border: 0;
            border-radius: 6px;
            padding: 6px 10px;
            background: transparent;
            color: var(--ci-muted);
            font-size: .875rem;
            font-weight: 700;
        }

        .ci-segment button.active {
            background: #fff;
            color: var(--ci-ink);
            box-shadow: 0 2px 8px rgba(23, 33, 43, .08);
        }

        .ci-actionbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(247, 250, 252, .92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(220, 227, 234, .75);
        }

        @media print {
            .navbar, .ci-actionbar, .btn { display: none !important; }
            body { background: #fff; }
            .ci-panel { box-shadow: none; break-inside: avoid; }
        }
    </style>
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg bg-white border-bottom">
    <div class="container ci-shell">
        <a class="navbar-brand fw-semibold" href="{{ path('dashboard') }}">ClinicInsight</a>
        <div class="d-flex gap-2">
            {% if app.user %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_logout') }}">Salir</a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="container ci-shell py-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
