{% extends 'base.html.twig' %}

{% block title %}Datos - ClinicInsight{% endblock %}

{% block body %}
<div class="ci-actionbar py-3 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="h3 mb-1">Explorador de datos</h1>
            <div class="text-muted">{{ uploadedFile.originalName }} · datos descifrados en sesion</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('report_show', {id: uploadedFile.id}) }}">Dashboard</a>
            <a class="btn btn-outline-primary" href="{{ path('report_export_json', {id: uploadedFile.id}) }}">JSON agregado</a>
        </div>
    </div>
</div>

<div class="ci-panel p-3 mb-4">
    <form class="row g-2 align-items-center">
        <div class="col-lg-8">
            <input class="form-control form-control-lg" name="q" value="{{ query }}" placeholder="Buscar en filas descifradas...">
        </div>
        <div class="col-lg-4 d-flex gap-2">
            <button class="btn btn-primary btn-lg flex-fill">Buscar</button>
            <a class="btn btn-outline-secondary btn-lg" href="{{ path('data_explorer', {id: uploadedFile.id}) }}">Limpiar</a>
        </div>
    </form>
    <div class="small text-muted mt-3">Se muestran hasta 250 filas para mantener la pantalla fluida. No se envia nada a OpenAI desde esta vista.</div>
</div>

<div class="row g-3" id="dataCards">
    {% for row in rows %}
        <div class="col-xl-6 data-card">
            <div class="ci-panel p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 mb-0">Fila {{ row.row_number }}</h2>
                    <button class="btn btn-sm btn-outline-primary" type="button" data-copy-row="{{ loop.index0 }}">Copiar JSON</button>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="ci-kpi-label mb-2">Normalizado</div>
                        {% for key, value in row.normalized %}
                            <div class="d-flex justify-content-between gap-3 border-bottom py-1 small">
                                <span class="text-muted">{{ key }}</span>
                                <span class="fw-semibold text-end">{{ value }}</span>
                            </div>
                        {% else %}
                            <div class="small text-muted">Sin normalizar</div>
                        {% endfor %}
                    </div>
                    <div class="col-md-6">
                        <div class="ci-kpi-label mb-2">Original</div>
                        {% for key, value in row.raw %}
                            <div class="d-flex justify-content-between gap-3 border-bottom py-1 small">
                                <span class="text-muted">{{ key }}</span>
                                <span class="fw-semibold text-end">{{ value }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <script type="application/json" data-row-json="{{ loop.index0 }}">{{ row|json_encode|raw }}</script>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-info">No hay filas que coincidan con la busqueda.</div>
        </div>
    {% endfor %}
</div>

<script>
document.querySelectorAll('[data-copy-row]').forEach(button => {
    button.addEventListener('click', async () => {
        const id = button.dataset.copyRow;
        const payload = document.querySelector(`[data-row-json="${id}"]`).textContent;
        await navigator.clipboard.writeText(JSON.stringify(JSON.parse(payload), null, 2));
        button.textContent = 'Copiado';
        setTimeout(() => button.textContent = 'Copiar JSON', 1200);
    });
});

document.querySelectorAll('.data-card').forEach((card, index) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(12px)';
    setTimeout(() => {
        card.style.transition = 'opacity .28s ease, transform .28s ease';
        card.style.opacity = '1';
        card.style.transform = 'translateY(0)';
    }, 35 * index);
});
</script>
{% endblock %}

