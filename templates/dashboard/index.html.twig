{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.your_projects'|trans }} - ClinicInsight{% endblock %}

{% block body %}
<section class="ci-hero p-4 p-lg-5 mb-4 ci-fade-up">
    <div class="row align-items-center g-4 position-relative">
        <div class="col-lg-7">
            <div class="ci-eyebrow mb-2">{{ app.user.customer.name }}</div>
            <h1 class="ci-page-title mb-3">{{ 'dashboard.title'|trans }}</h1>
            <p class="lead ci-muted mb-4">{{ 'dashboard.subtitle'|trans({'{customer}': app.user.customer.name}) }}</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" href="{{ path('project_new') }}">{{ 'dashboard.new_project'|trans }}</a>
                <a class="btn ci-soft-btn btn-lg" href="{{ path('modules_index') }}">{{ 'dashboard.view_modules'|trans }}</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-3">
                <div class="col-6">
                    <div class="ci-panel ci-kpi p-3">
                        <div class="ci-kpi-label">{{ 'common.projects'|trans }}</div>
                        <div class="ci-kpi-value">{{ projects|length }}</div>
                        <div class="ci-kpi-sub">{{ 'nav.account'|trans }}</div>
                    </div>
                </div>
                <div class="col-6">
                    {% set totalFiles = 0 %}
                    {% for project in projects %}
                        {% set totalFiles = totalFiles + project.uploadedFiles|length %}
                    {% endfor %}
                    <div class="ci-panel ci-kpi p-3" style="--accent: var(--ci-blue)">
                        <div class="ci-kpi-label">{{ 'project.files'|trans }}</div>
                        <div class="ci-kpi-value">{{ totalFiles }}</div>
                        <div class="ci-kpi-sub">{{ 'dashboard.loaded_files'|trans }}</div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="ci-panel p-3">
                        <div class="ci-kpi-label mb-2">{{ 'dashboard.recommended_flow'|trans }}</div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="ci-status-pill">{{ 'dashboard.import_all'|trans }}</span>
                            <span class="ci-status-pill">{{ 'dashboard.detect'|trans }}</span>
                            <span class="ci-status-pill">{{ 'dashboard.review'|trans }}</span>
                            <span class="ci-status-pill">{{ 'dashboard.dashboard'|trans }}</span>
                            <span class="ci-status-pill">{{ 'dashboard.export'|trans }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h2 class="h4 mb-1">{{ 'dashboard.your_projects'|trans }}</h2>
        <div class="text-muted">{{ 'dashboard.project_hint'|trans }}</div>
    </div>
    <a class="btn btn-outline-primary" href="{{ path('project_new') }}">{{ 'dashboard.create_project'|trans }}</a>
</div>

<div class="row g-3">
    {% for project in projects %}
        <div class="col-md-6 col-xl-4">
            <a class="ci-card-link ci-panel p-3 h-100 ci-fade-up" style="animation-delay: {{ loop.index0 * 45 }}ms" href="{{ path('project_show', {id: project.id}) }}">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <span class="ci-icon-box">{{ project.name|slice(0, 1)|upper }}</span>
                    <span class="badge text-bg-light border">{{ 'dashboard.file_count'|trans({'{count}': project.uploadedFiles|length}) }}</span>
                </div>
                <h3 class="h5 mb-2">{{ project.name }}</h3>
                <p class="text-muted small mb-3">{{ project.description ?: 'dashboard.default_description'|trans }}</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted">{{ project.user.userIdentifier == app.user.userIdentifier ? 'dashboard.own'|trans : 'dashboard.shared_with_you'|trans }}</span>
                    <span class="btn btn-sm btn-primary">{{ 'dashboard.open'|trans }}</span>
                </div>
            </a>
        </div>
    {% else %}
        <div class="col-12">
            <div class="ci-panel p-4 text-center">
                <div class="ci-icon-box mx-auto mb-3">+</div>
                <h2 class="h5">{{ 'dashboard.empty_title'|trans }}</h2>
                <p class="text-muted">{{ 'dashboard.empty_text'|trans }}</p>
                <a class="btn btn-primary" href="{{ path('project_new') }}">{{ 'dashboard.create_project'|trans }}</a>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
