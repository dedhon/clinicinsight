{% extends 'base.html.twig' %}

{% block title %}Dashboard - ClinicInsight{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Proyectos</h1>
        <p class="text-muted mb-0">Analisis agregados de actividad clinica.</p>
    </div>
    <a class="btn btn-primary" href="{{ path('project_new') }}">Nuevo proyecto</a>
</div>

<div class="row g-3">
    {% for project in projects %}
        <div class="col-md-6 col-xl-4">
            <a class="card text-decoration-none text-dark h-100" href="{{ path('project_show', {id: project.id}) }}">
                <div class="card-body">
                    <h2 class="h5">{{ project.name }}</h2>
                    <p class="text-muted">{{ project.description ?: 'Sin descripcion' }}</p>
                    <span class="badge text-bg-light">{{ project.uploadedFiles|length }} archivos</span>
                </div>
            </a>
        </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-info">Crea tu primer proyecto para subir un Excel o CSV.</div>
        </div>
    {% endfor %}
</div>
{% endblock %}

