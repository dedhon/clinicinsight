{% extends 'base.html.twig' %}

{% block title %}Administracion - ClinicInsight{% endblock %}

{% block body %}
<div class="ci-actionbar py-3 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="ci-eyebrow mb-1">Backoffice propietario</div>
            <h1 class="h3 mb-1">{{ 'admin.title'|trans }}</h1>
            <div class="text-muted">{{ 'admin.subtitle'|trans }}</div>
        </div>
        <a class="btn btn-outline-secondary" href="{{ path('dashboard') }}">{{ 'admin.back_to_app'|trans }}</a>
    </div>
</div>

<div class="ci-panel p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label class="form-label fw-semibold" for="adminSearch">{{ 'common.search'|trans }}</label>
            <input class="form-control form-control-lg" id="adminSearch" name="q" value="{{ filters.q }}" placeholder="Cliente, slug, email, usuario...">
        </div>
        <div class="col-md-4 col-lg-3">
            <label class="form-label fw-semibold" for="customerFilter">{{ 'common.client'|trans }}</label>
            <select class="form-select form-select-lg" id="customerFilter" name="customer_id">
                <option value="0">Todos los clientes</option>
                {% for customer in allCustomers %}
                    <option value="{{ customer.id }}" {{ filters.customer_id == customer.id ? 'selected' }}>{{ customer.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label fw-semibold" for="planFilter">{{ 'common.plan'|trans }}</label>
            <select class="form-select form-select-lg" id="planFilter" name="plan">
                <option value="">Todos</option>
                {% for key, plan in plans %}
                    <option value="{{ key }}" {{ filters.plan == key ? 'selected' }}>{{ plan.label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label fw-semibold" for="statusFilter">{{ 'common.status'|trans }}</label>
            <select class="form-select form-select-lg" id="statusFilter" name="status">
                <option value="">Todos</option>
                {% for status in statuses %}
                    <option value="{{ status }}" {{ filters.status == status ? 'selected' }}>{{ statusLabels[status]|default(status) }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-12 col-lg-1 d-flex gap-2">
            <button class="btn btn-primary btn-lg flex-fill">{{ 'common.filter'|trans }}</button>
            <a class="btn btn-outline-secondary btn-lg" href="{{ path('admin_dashboard') }}">{{ 'common.clear'|trans }}</a>
        </div>
    </form>
</div>

<div class="row g-3 mb-4">
    {% for key, plan in plans %}
        <div class="col-md-4">
            <div class="ci-panel p-3 h-100">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <div class="ci-kpi-label">{{ plan.label }}</div>
                        <div class="h3 mb-0">{{ plan.monthly_price }} €/mes</div>
                    </div>
                    <span class="badge text-bg-light border">{{ allCustomers|filter(c => c.plan == key)|length }} clientes</span>
                </div>
                <div class="small text-muted mb-3">{{ plan.target }}</div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="ci-status-pill">{{ plan.max_users }} usuarios</span>
                    <span class="ci-status-pill">{{ plan.max_projects }} proyectos</span>
                    <span class="ci-status-pill">{{ plan.max_datasets }} archivos de datos</span>
                    <span class="ci-status-pill">{{ plan.max_upload_mb }} MB</span>
                    <span class="ci-status-pill">{{ plan.max_storage_gb }} GB total</span>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

<div class="ci-panel p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <div class="ci-kpi-label">Alta manual controlada</div>
            <h2 class="h5 mb-1">Crear cliente</h2>
            <div class="text-muted small">Para ventas manuales, demos o migraciones. El alta automatica con Stripe reutilizara esta misma estructura.</div>
        </div>
    </div>
    <form method="post" action="{{ path('admin_customer_create') }}" class="row g-3 align-items-end">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_customer_create') }}">
        <div class="col-md-4">
            <label class="form-label fw-semibold" for="customerName">Cliente</label>
            <input class="form-control" id="customerName" name="name" placeholder="Clinica Dental Lopez" required>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold" for="customerPlan">Plan</label>
            <select class="form-select" id="customerPlan" name="plan">
                {% for key, plan in plans %}
                    <option value="{{ key }}">{{ plan.label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold" for="customerStatus">Estado</label>
            <select class="form-select" id="customerStatus" name="subscription_status">
                {% for status in statuses %}
                    <option value="{{ status }}">{{ statusLabels[status]|default(status) }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold" for="billingEmail">Correo de facturacion</label>
            <input class="form-control" id="billingEmail" name="billing_email" type="email" placeholder="facturacion@cliente.com">
        </div>
        <div class="col-md-1 d-grid">
            <button class="btn btn-primary">Crear</button>
        </div>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="ci-panel ci-kpi p-3">
            <div class="ci-kpi-label">Clientes</div>
            <div class="ci-kpi-value">{{ customers|length }}</div>
            <div class="ci-kpi-sub">cuentas registradas</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ci-panel ci-kpi p-3" style="--accent: var(--ci-blue)">
            <div class="ci-kpi-label">Usuarios</div>
            <div class="ci-kpi-value">{{ users|length }}</div>
            <div class="ci-kpi-sub">entre todos los clientes</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ci-panel ci-kpi p-3" style="--accent: var(--ci-amber)">
            <div class="ci-kpi-label">Cuentas en prueba</div>
            <div class="ci-kpi-value">{{ customers|filter(c => c.subscriptionStatus == 'trial')|length }}</div>
            <div class="ci-kpi-sub">pendientes de pasar a pago</div>
        </div>
    </div>
</div>

<div class="ci-panel p-0 overflow-hidden mb-4">
    <div class="p-3 border-bottom">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 class="h5 mb-0">Clientes</h2>
                <div class="small text-muted">Mostrando {{ customers|length }} de {{ customerPagination.total }} resultados. Maximo {{ customerPagination.limit }} por pagina.</div>
            </div>
            <span class="badge text-bg-light border">Pagina {{ customerPagination.page }}/{{ customerPagination.pages }}</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>Cliente</th>
                <th>Plan</th>
                <th>Estado</th>
                <th>Usuarios</th>
                <th>Proyectos</th>
                <th style="min-width: 360px">Gestion</th>
            </tr>
            </thead>
            <tbody>
            {% for customer in customers %}
                <tr>
                    <td>
                        <div class="fw-semibold">{{ customer.name }}</div>
                        <div class="small text-muted">{{ customer.slug }}</div>
                    </td>
                    {% set plan = plans[customer.plan]|default(plans.starter) %}
                    {% set userLimitReached = customer.users|length >= plan.max_users %}
                    {% set projectLimitReached = customer.projects|length >= plan.max_projects %}
                    <td>
                        <span class="badge text-bg-light border">{{ plan.label }}</span>
                        <div class="small text-muted">{{ plan.monthly_price }} €/mes</div>
                    </td>
                    <td><span class="ci-status-pill">{{ statusLabels[customer.subscriptionStatus]|default(customer.subscriptionStatus) }}</span></td>
                    <td>
                        <span class="{{ userLimitReached ? 'text-danger fw-semibold' : '' }}">{{ customer.users|length }}/{{ plan.max_users }}</span>
                    </td>
                    <td>
                        <span class="{{ projectLimitReached ? 'text-danger fw-semibold' : '' }}">{{ customer.projects|length }}/{{ plan.max_projects }}</span>
                    </td>
                    <td>
                        <form method="post" action="{{ path('admin_customer_subscription', {id: customer.id}) }}" class="row g-2 align-items-end">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_customer_' ~ customer.id) }}">
                            <div class="col-6">
                                <label class="form-label small mb-1">Plan</label>
                                <select class="form-select form-select-sm" name="plan">
                                    {% for key, plan in plans %}
                                        <option value="{{ key }}" {{ customer.plan == key ? 'selected' }}>{{ plan.label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1">Estado</label>
                                <select class="form-select form-select-sm" name="subscription_status">
                                    {% for status in statuses %}
                                        <option value="{{ status }}" {{ customer.subscriptionStatus == status ? 'selected' }}>{{ statusLabels[status]|default(status) }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-6">
                                <input class="form-control form-control-sm" name="billing_email" placeholder="billing@email.com" value="{{ customer.billingEmail }}">
                            </div>
                            <div class="col-6">
                                <input class="form-control form-control-sm" name="stripe_customer_id" placeholder="cus_..." value="{{ customer.stripeCustomerId }}">
                            </div>
                            <div class="col-12">
                                <button class="btn btn-sm btn-primary">Guardar</button>
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_customer_show', {id: customer.id}) }}">Abrir ficha</a>
                            </div>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-center text-muted py-4">No hay clientes todavia.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if customerPagination.pages > 1 %}
        <div class="p-3 border-top d-flex justify-content-end gap-2">
            {% set prevCustomerPage = customerPagination.page - 1 %}
            {% set nextCustomerPage = customerPagination.page + 1 %}
            <a class="btn btn-sm btn-outline-secondary {{ customerPagination.page <= 1 ? 'disabled' }}" href="{{ path('admin_dashboard', filters|merge({customer_page: prevCustomerPage, user_page: userPagination.page})) }}">Anterior</a>
            <a class="btn btn-sm btn-outline-secondary {{ customerPagination.page >= customerPagination.pages ? 'disabled' }}" href="{{ path('admin_dashboard', filters|merge({customer_page: nextCustomerPage, user_page: userPagination.page})) }}">Siguiente</a>
        </div>
    {% endif %}
</div>

<div class="ci-panel p-0 overflow-hidden">
    <div class="p-3 border-bottom">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 class="h5 mb-0">Usuarios</h2>
                <div class="small text-muted">Mostrando {{ users|length }} de {{ userPagination.total }} resultados. Maximo {{ userPagination.limit }} por pagina.</div>
            </div>
            <span class="badge text-bg-light border">Pagina {{ userPagination.page }}/{{ userPagination.pages }}</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>Usuario</th>
                <th>Cliente</th>
                <th style="min-width: 260px">Permisos</th>
                <th>Alta</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>
                        <div class="fw-semibold">{{ user.name }}</div>
                        <div class="small text-muted">{{ user.email }}</div>
                    </td>
                    <td>{{ user.customer.name }}</td>
                    <td>
                        <form method="post" action="{{ path('admin_user_roles', {id: user.id}) }}" class="d-flex flex-wrap align-items-center gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_user_' ~ user.id) }}">
                            <input type="hidden" name="customer_id" value="{{ user.customer.id }}">
                            <label class="form-check small mb-0">
                                <input class="form-check-input" type="checkbox" name="customer_admin" value="1" {{ 'ROLE_CUSTOMER_ADMIN' in user.roles ? 'checked' }}>
                                Administrador del cliente
                            </label>
                            <label class="form-check small mb-0">
                                <input class="form-check-input" type="checkbox" name="super_admin" value="1" {{ 'ROLE_SUPER_ADMIN' in user.roles ? 'checked' }}>
                                Superadministrador
                            </label>
                            <button class="btn btn-sm btn-outline-primary">Guardar</button>
                        </form>
                    </td>
                    <td class="small text-muted">{{ user.createdAt|date('d/m/Y') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if userPagination.pages > 1 %}
        <div class="p-3 border-top d-flex justify-content-end gap-2">
            {% set prevUserPage = userPagination.page - 1 %}
            {% set nextUserPage = userPagination.page + 1 %}
            <a class="btn btn-sm btn-outline-secondary {{ userPagination.page <= 1 ? 'disabled' }}" href="{{ path('admin_dashboard', filters|merge({customer_page: customerPagination.page, user_page: prevUserPage})) }}">Anterior</a>
            <a class="btn btn-sm btn-outline-secondary {{ userPagination.page >= userPagination.pages ? 'disabled' }}" href="{{ path('admin_dashboard', filters|merge({customer_page: customerPagination.page, user_page: nextUserPage})) }}">Siguiente</a>
        </div>
    {% endif %}
</div>
{% endblock %}
